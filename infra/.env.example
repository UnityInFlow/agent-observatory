# Host port mapping for the local ecosystem.
# Copy to infra/.env and change any value that collides with something already running
# on your machine (`make up` fails loudly with "port is already allocated").
#
# Container-internal ports never change — only what is published on the host.

POSTGRES_PORT=5432
TEMPO_PORT=3200
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
COLLECTOR_METRICS_PORT=8889
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
API_PORT=8080
WEB_PORT=5173
