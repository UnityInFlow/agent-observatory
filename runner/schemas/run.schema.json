{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unityinflow.dev/agent-observatory/run.schema.json",
  "title": "Normalized agent run record",
  "description": "Vendor-neutral record of one agent run (chapter 00 §12). Raw spans stay in Tempo and aggregates in Prometheus; this is the stable shape the comparison layer depends on, and it must never be reshaped to mirror a vendor's telemetry (§35).",
  "type": "object",
  "required": ["benchmarkId", "variant", "runtime"],
  "additionalProperties": false,
  "properties": {
    "runId": {
      "type": "string",
      "format": "uuid",
      "description": "Generated by the runner before the agent starts so it can be used as the observatory.run.id OTel resource attribute."
    },
    "experimentId": {
      "type": "string",
      "description": "Human experiment key such as EXP-001; resolved to an internal UUID server-side."
    },
    "benchmarkId": { "type": "string", "examples": ["BE-001"] },
    "variant": {
      "type": "string",
      "description": "baseline | instructions | skill | agent | ...",
      "examples": ["baseline", "instructions"]
    },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": ["string", "null"], "format": "date-time" },

    "runtime": {
      "type": "object",
      "required": ["provider", "product"],
      "additionalProperties": false,
      "properties": {
        "provider": { "type": "string", "examples": ["github", "anthropic", "openai"] },
        "product": { "type": "string", "examples": ["copilot-cli", "claude-code", "codex"] },
        "version": { "type": ["string", "null"], "description": "Record the real version, never a placeholder." },
        "model": { "type": ["string", "null"], "description": "Record the real model." }
      }
    },

    "repository": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commitSha": { "type": ["string", "null"] },
        "dirtyBeforeRun": { "type": "boolean", "default": false }
      }
    },

    "customization": {
      "type": "object",
      "description": "§12: recording only variant='instructions' is not reproducible. Hash the exact files used for this run.",
      "additionalProperties": false,
      "properties": {
        "instructionsHash": { "type": ["string", "null"] },
        "skillsHash": { "type": ["string", "null"] },
        "agentHash": { "type": ["string", "null"] },
        "hooksHash": { "type": ["string", "null"] },
        "mcpHash": { "type": ["string", "null"] }
      }
    },

    "behavior": {
      "type": "object",
      "description": "Normalized by a vendor adapter into the same shape regardless of native telemetry.",
      "additionalProperties": false,
      "properties": {
        "modelCalls": { "type": "integer", "minimum": 0, "default": 0 },
        "toolCalls": { "type": "integer", "minimum": 0, "default": 0 },
        "toolFailures": { "type": "integer", "minimum": 0, "default": 0 },
        "retries": { "type": "integer", "minimum": 0, "default": 0 },
        "permissionRequests": { "type": "integer", "minimum": 0, "default": 0 },
        "permissionDenials": { "type": "integer", "minimum": 0, "default": 0 }
      }
    },

    "efficiency": {
      "type": "object",
      "description": "Nulls are meaningful: they mean the runtime does not expose the value, which is different from zero.",
      "additionalProperties": false,
      "properties": {
        "durationMs": { "type": ["integer", "null"], "minimum": 0 },
        "inputTokens": { "type": ["integer", "null"], "minimum": 0 },
        "outputTokens": { "type": ["integer", "null"], "minimum": 0 },
        "cachedTokens": { "type": ["integer", "null"], "minimum": 0 },
        "cacheCreationTokens": { "type": ["integer", "null"], "minimum": 0 },
        "estimatedCost": { "type": ["number", "null"], "minimum": 0 }
      }
    },

    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "changedFiles": { "type": "array", "items": { "type": "string" } },
        "addedLines": { "type": "integer", "minimum": 0, "default": 0 },
        "deletedLines": { "type": "integer", "minimum": 0, "default": 0 }
      }
    },

    "traceId": { "type": ["string", "null"], "description": "§17: correlation to the raw trace when the runtime exposes it." },
    "telemetryQueryKey": {
      "type": ["string", "null"],
      "description": "TraceQL that finds this run in Tempo, e.g. { resource.observatory.run.id = \"...\" }."
    }
  }
}
